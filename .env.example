# Copy to .env before `docker compose up`. Defaults match these values, so a
# stock copy is enough for local development.

POSTGRES_USER=panoptes
POSTGRES_PASSWORD=panoptes
POSTGRES_DB=panoptes

# Used by the backend. The hostname `db` is the Compose service name.
DATABASE_URL=postgresql+psycopg://panoptes:panoptes@db:5432/panoptes

# Signs JWTs. Must be at least 32 characters. The app warns if this still starts with "change-me".
SECRET_KEY=change-me-please-use-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# JSON list. The Vite dev server origin.
CORS_ORIGINS=["http://localhost:5173"]

# Upload limits and Bandit. Defaults are used when these are unset.
MAX_UPLOAD_BYTES=20971520
MAX_UNCOMPRESSED_BYTES=104857600
MAX_FILE_COUNT=5000
BANDIT_TIMEOUT_SECONDS=120
SEMGREP_TIMEOUT_SECONDS=300
GITLEAKS_TIMEOUT_SECONDS=60
CLONE_TIMEOUT_SECONDS=60
SEMGREP_RULES_DIR=/opt/semgrep-rules
MAX_CONCURRENT_SCANS=2
MAX_QUEUED_SCANS=8
SCAN_RATE_LIMIT=5
SCAN_RATE_WINDOW_SECONDS=60
# Login attempts per minute. The IP limit is lower so one host cannot lock an account.
LOGIN_RATE_LIMIT_IP=10
LOGIN_RATE_LIMIT_EMAIL=20
LOGIN_RATE_WINDOW_SECONDS=60
