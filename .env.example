# Copy to .env before `docker compose up`. Defaults match these values, so a
# stock copy is enough for local development.

POSTGRES_USER=panoptes
POSTGRES_PASSWORD=panoptes
POSTGRES_DB=panoptes

# Used by the backend. The hostname `db` is the Compose service name.
DATABASE_URL=postgresql+psycopg://panoptes:panoptes@db:5432/panoptes

# Placeholder until Phase 1 (JWT signing). Not a real secret.
SECRET_KEY=change-me

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# JSON list. The Vite dev server origin.
CORS_ORIGINS=["http://localhost:5173"]
